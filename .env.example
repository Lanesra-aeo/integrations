# Copy to .env and fill in. .env is ignored by git.

# Your key, from Integrations → API keys in the Lanesra app.
LANESRA_API_KEY=lns_live_your_key_here

# A project slug. Needed only when the key reads several projects.
LANESRA_PROJECT=

# Optional: a Slack incoming webhook for the report and the alert.
SLACK_WEBHOOK_URL=
